# ==============================================================================
# ForecastAI Configuration & Environment Variables (.env.example)
# ==============================================================================

# ── Application Runtime (Cloud Run Environment Variables) ──────────────────────
# In production, Cloud Run sets PORT automatically (default 8080)
NODE_ENV=production
PORT=8080

# Path to python3 binary (in container: /opt/venv/bin/python3, on local Windows: py or python)
PYTHON_EXECUTABLE=/opt/venv/bin/python3

# ── CORS & Domain Configuration ───────────────────────────────────────────────
# Primary frontend URL (e.g. Firebase Hosting or custom domain)
FRONTEND_URL=https://forecastai-frontend.vercel.app

# Additional allowed origins (comma-separated, no trailing slashes)
# Include any additional deployed frontend origins that need API access.
ALLOWED_ORIGINS=https://forecastai-frontend.vercel.app,https://forecastai-prod.web.app,https://forecastai-prod.firebaseapp.com

# ── Database & Persistent Storage (Cloud Run / Firestore) ────────────────────
# Storage engine: 'firestore' for Google Cloud Firestore, or 'file' for local data.json
DATABASE_TYPE=firestore

# Google Cloud Project ID (used by Firestore, Secret Manager, Cloud Storage)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Dedicated Google Cloud Storage bucket for dataset uploads and models
# If omitted, local container uploads directory is used
GOOGLE_CLOUD_STORAGE_BUCKET=forecastai-datasets-your-project-id

# Local development only: path to service account key file
# In production Cloud Run, leave this empty to use Application Default Credentials (ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Security & Authentication (Configure via Google Secret Manager) ────────────
# Strong random secret key (minimum 32 characters) for signing JWT auth tokens
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Email Delivery (Nodemailer / SMTP — Secret Manager) ───────────────────────
# Gmail App Password or SMTP provider credentials for OTP verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="ForecastAI <noreply@forecastai.internal>"

# ── SMS Delivery (Twilio — Optional / Secret Manager) ─────────────────────────
# Twilio credentials for SMS OTP verification
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
